{
  "name": "monoprint",
  "version": "0.1.0",
  "description": "Offline code-image rendering for Node.js",
  "license": "Apache-2.0",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    "assets",
    "docs",
    "vendor/takumi-svg",
    "vendor/takumi-raster"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:js": "node scripts/build.mjs --js-only",
    "test": "node --test test/*.test.mjs",
    "test:types": "tsc -p test/tsconfig.json",
    "test:package": "node scripts/test-package.mjs",
    "package": "node scripts/package.mjs",
    "publish:packages": "node scripts/publish.mjs",
    "prepublishOnly": "node scripts/require-staging.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "esbuild": "0.25.12",
    "typescript": "7.0.2"
  }
}
