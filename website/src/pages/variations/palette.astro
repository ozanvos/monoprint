---
import Base from '../../variations/Base.astro';
import { themes, initialTheme } from '../../data/demo.mjs';
import { palettes, tokens } from '../../variations/palettes.mjs';
import '../../variations/palette.css';
const vars = (id: string) => Object.entries(palettes[id as keyof typeof palettes]).map(([k, v]) => `--${k}:${v}`).join(';');
---
<Base id="palette">
  <div slot="hero-aside" class="live" data-palettes={JSON.stringify(palettes)} data-themes={JSON.stringify(themes.map(t => ({ id: t.id, cli: t.cli })))}>
    <figure class="sample" style={vars(initialTheme.id)}>
      <div class="sample-bar"><i></i><i></i><i></i><span>share.rs</span></div>
      <pre class="sample-code"><code>{tokens.map((line, i) => <span class:list={['ln', { hl: i === 3 }]}><span class="num" aria-hidden="true">{i + 1}</span>{line.map(([c, t]) => c ? <span class={`t-${c}`}>{t}</span> : t)}{'\n'}</span>)}</code></pre>
    </figure>
    <div class="live-meta">
      <button class="icon-button" type="button" id="cycle" aria-label="Pause theme cycle" aria-pressed="false"><svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path class="pause" d="M3 2h2v8H3zM7 2h2v8H7z" fill="currentColor"/><path class="play" d="M3 2l7 4-7 4z" fill="currentColor"/></svg></button>
      <span class="flag">--theme <span class="flag-value" id="flag">{initialTheme.cli}</span></span>
      <span class="timer" aria-hidden="true"><i></i></span>
    </div>
  </div>
</Base>
<script src="../../variations/palette.ts"></script>
