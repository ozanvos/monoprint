---
import AppDemo from '../components/AppDemo.astro';
import Icon from '../components/Icon.astro';
import { initialTheme } from '../data/demo.mjs';
import release from '../../../release/config.json';
import '../styles/site.css';
const repository = `https://github.com/${release.repository}`;
const docs = `${repository}/blob/main/README.md`;
const cliDocs = `${repository}/blob/main/docs/cli.md`;
const showcases = [
  { image: '/assets/catppuccin-plain.png', name: 'Catppuccin Mocha', detail: '1 of 96 appearances', alt: 'Rust code in Catppuccin Mocha' },
  { image: '/assets/ayu.png', name: 'Line 4 highlighted', detail: 'Ayu Light', alt: 'Rust code in Ayu Light, with line four highlighted' },
  { image: '/assets/gruvbox-transparent.svg', name: 'Transparent background', detail: 'SVG', alt: 'Rust code in Gruvbox on a transparent background', transparent: true },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Create code images locally with the Monoprint macOS app, CLI, or Rust and TypeScript APIs." />
    <meta name="robots" content="noindex,nofollow" />
    <title>Monoprint | Code images</title>
    <link rel="icon" href="/assets/icon.png" />
    <link rel="preload" href="/assets/jetbrains-mono.ttf" as="font" type="font/ttf" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page">
      <header class="masthead">
        <a class="brand" href="/">Monoprint</a>
        <nav aria-label="Main"><a href={docs}>Docs</a><a href={`${docs}#options`}>CLI</a><a href={repository}>GitHub ↗</a><button class="button strong" type="button" disabled title="Downloads are being prepared">Download</button></nav>
      </header>
      <main id="main">
        <section class="hero" aria-labelledby="hero-title">
          <h1 id="hero-title">Code images.</h1>
          <p>Turn source code into PNG, SVG or HTML on your Mac.</p>
          <div class="hero-actions">
            <button class="button strong hero-download" type="button" disabled title="Downloads are being prepared">Download</button>
            <div class="cli-command" id="cli"><span class="prompt" aria-hidden="true">$</span><code id="command-text">monoprint share.rs --theme <span class="command-theme">{initialTheme.cli}</span> --highlight 4</code><button class="icon-button" id="copy-command" aria-label="Copy CLI command" title="Copy command" type="button"><Icon name="copy"/></button></div>
          </div>
        </section>
        <div class="app-section"><AppDemo /></div>
        <section class="showcase" aria-label="Export examples">
          {showcases.map(item => <figure><div class:list={['showcase-tile', { lattice: item.transparent }]}><img src={item.image} width="1280" height="666" alt={item.alt} loading="lazy" /></div><figcaption><span>{item.name}</span><span>{item.detail}</span></figcaption></figure>)}
        </section>
      </main>
      <footer><span>Monoprint</span><nav aria-label="Resources"><a href={docs}>Docs</a><a href={`${docs}#options`}>CLI</a><a href={`${repository}/blob/main/docs/library.md`}>Rust</a><a href={`${repository}/tree/main/bindings/node`}>TypeScript</a><a href={repository}>Source on GitHub ↗</a></nav></footer>
    </div>
    <p class="sr-only" role="status" id="feedback" aria-live="polite"></p>
    <script src="../scripts/demo.ts"></script>
  </body>
</html>
