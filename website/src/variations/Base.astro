---
// Review copy of pages/index.astro. Each variation page wraps it with its own
// stylesheet and script; `hero-aside` lets a variation place something beside the headline.
import AppScreenshot from '../components/AppScreenshot.astro';
import Icon from '../components/Icon.astro';
import { themes, initialTheme, command } from '../data/demo.mjs';
import { showcases } from '../data/showcase.mjs';
import release from '../../../release/config.json';
import { downloads, manifest } from '../data/downloads.mjs';
import { variations } from './list.mjs';
import { highlighters, shell } from './highlight.mjs';
import '../styles/site.css';
import './switcher.css';
interface Props { id: string; highlight?: boolean; }
const { id, highlight = false } = Astro.props;
const index = variations.findIndex(v => v.id === id);
const current = variations[index];
const prev = variations[(index + variations.length - 1) % variations.length];
const next = variations[(index + 1) % variations.length];
const repository = `https://github.com/${release.repository}`;
const docs = `${repository}/blob/main/README.md`;
const cliDocs = `${repository}/blob/main/docs/cli.md`;
const parts = [
  { title: 'Studio', lang: 'keys', body: 'Live preview, line and text highlights, custom fonts, clipboard export and a saved local draft.', code: ['⌘O  Open source file', '⌘S  Export image', '⌘⇧C Copy image'] },
  { title: 'CLI', lang: 'shell', body: 'Reads a file or stdin. The output extension picks the format; --list-themes shows every variant.', code: ['monoprint main.rs -o main.png', '  --theme nord --scale 4', 'pbpaste | monoprint -l ts -o a.svg'] },
  { title: 'Library', lang: 'rust', body: 'Render in memory from Rust, or from Node.js 22+ with native packages for macOS, Linux and Windows.', code: ['Renderer::new().png(', '  &snippet, &Style::default(),', '  Scale::X2)?'] },
];
const hasAside = Astro.slots.has('hero-aside');
---
<!doctype html>
<html lang="en" data-variation={id}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Monoprint | {current.name}</title>
    <link rel="icon" href="/assets/icon.png" />
    <link rel="preload" href="/assets/jetbrains-mono.ttf" as="font" type="font/ttf" crossorigin />
    <script is:inline>if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page">
      <header class="strip">
        <a class="brand" href="/"><svg class="brand-mark" viewBox="196 249 633 498" aria-hidden="true"><path class="connector" d="M 510 381 L 620 522 L 499 598 L 465 548 Z"/><path class="front" d="M 220 448 L 493 263 Q 513 252 513 275 L 512 505 Q 512 515 502 522 L 220 720 Q 199 732 201 708 L 208 468 Q 208 457 220 448 Z"/><path class="back" d="M 499 598 L 781 407 Q 798 395 801 416 L 823 598 Q 826 613 813 621 L 625 735 Q 613 744 605 731 Z"/></svg>Monoprint</a>
        <nav aria-label="Main">{release.publicPublishing && <><a href={docs}>Docs</a><a href={cliDocs}>CLI</a><a href={repository}>GitHub ↗</a></>}<a href="/support/">Support</a>{manifest ? <a class="button ink" href="#downloads">Download</a> : <button class="button ink" type="button" disabled title="Downloads are being prepared">Download</button>}</nav>
      </header>
      <main id="main">
        <section class:list={['hero', { 'has-aside': hasAside }]} aria-labelledby="hero-title">
          <div class="hero-copy">
            <p class="eyebrow">macOS · Windows · Linux · CLI · Rust · TypeScript</p>
            <h1 id="hero-title">Code images.</h1>
            <p class="lede">Turn source code into PNG, SVG or HTML on your computer. Fonts, themes and grammars are bundled, so your code stays on the machine.</p>
            <div class="actions">
              {manifest ? <a class="button ink" href="#downloads">Download</a> : <button class="button ink" type="button" disabled title="Downloads are being prepared">Download</button>}
              <div class="cli-command"><span class="prompt" aria-hidden="true">$</span><code id="command-text">{command(initialTheme)}</code><button class="icon-button" id="copy-command" aria-label="Copy CLI command" title="Copy command" type="button"><Icon name="copy"/></button></div>
            </div>
          </div>
          <slot name="hero-aside" />
        </section>

        <section class="app-section" aria-label="App screenshot"><AppScreenshot /></section>

        {manifest && <section class="downloads" id="downloads" aria-labelledby="downloads-title">
          <h2 id="downloads-title">Get Monoprint</h2>
          <p>Version {manifest.version}. Free and open source. Updates are built in.</p>
          {!manifest.downloads['win-x64'] && <p>Windows downloads are coming later.</p>}
          <div class="download-platforms">{downloads.map(download => <div>
            <a class="button ink" href={download.url}>{download.label}</a>
            <p>{download.detail}</p>
          </div>)}</div>
          <p>On macOS, install the app and CLI with <a href="https://github.com/ozanvos/homebrew-tap">Homebrew</a>:</p>
          <pre class="install-command">{highlight ? <code set:html={shell('brew install --cask ozanvos/tap/monoprint')} /> : <code>brew install --cask ozanvos/tap/monoprint</code>}</pre>
          <p><a href={`${repository}/releases/tag/${manifest.tag}`}>Release notes, checksums and signatures ↗</a></p>
        </section>}

        <section class="themes" aria-labelledby="themes-title">
          <div class="picker">
            <h2 id="themes-title">Themes</h2>
            <p><code>--list-themes</code> lists every theme and appearance.</p>
            <div class="options" role="radiogroup" aria-label="Theme">
              {themes.map(theme => <label class="option"><input type="radio" name="theme" value={theme.id} checked={theme.id === initialTheme.id} data-command={command(theme)} /><span class="swatch" aria-hidden="true" style={`--bg:${theme.bg};--fg:${theme.accent}`}></span><span>{theme.name}</span><code>{theme.cli}</code></label>)}
            </div>
          </div>
          <div class="stage lattice">
            <div class="sheet">{themes.map(theme => <img src={`/assets/${theme.id}.png`} width="1280" height="666" alt={`Rust code in ${theme.name}, with line four highlighted`} data-theme={theme.id} hidden={theme.id !== initialTheme.id} />)}</div>
          </div>
        </section>

        <section class="parts" aria-label="Interfaces">
          {parts.map(part => <article><h2>{part.title}</h2><p>{part.body}</p>{highlight ? <pre set:html={part.code.map(highlighters[part.lang as keyof typeof highlighters]).join('\n')} /> : <pre>{part.code.join('\n')}</pre>}</article>)}
        </section>

        <section class="showcase" aria-label="Export examples">
          {showcases.map(item => <figure data-source={item.source} data-theme={`${item.theme} ${item.appearance}`} data-format={item.format} data-transparent={item.transparent ? '' : undefined}><div class="showcase-tile"><img src={`/assets/${item.id}.${item.format}`} alt={item.alt} loading="lazy" /></div><figcaption><span>{item.name}</span><span>{item.detail}</span></figcaption></figure>)}
        </section>
      </main>
      <footer class="strip foot"><span>Monoprint</span><nav aria-label="Resources"><a href="/support/">Support</a><a href="/privacy/">Privacy</a><a href="mailto:contact@7ea.st">Contact</a>{release.publicPublishing && <><a href={docs}>Docs</a><a href={cliDocs}>CLI</a><a href={`${repository}/blob/main/docs/library.md`}>Rust</a><a href={`${repository}/tree/main/bindings/node`}>TypeScript</a><a href={repository}>Source on GitHub ↗</a></>}</nav></footer>
    </div>
    <nav class="variation-switcher" aria-label="Variations">
      <a href={`/variations/${prev.id}/`} aria-label={`Previous: ${prev.name}`}>←</a>
      <a class="current" href="/variations/">{index + 1}/{variations.length} · {current.name}</a>
      <a href={`/variations/${next.id}/`} aria-label={`Next: ${next.name}`}>→</a>
    </nav>
    <p class="sr-only" role="status" id="feedback" aria-live="polite"></p>
    <script src="../scripts/demo.ts"></script>
  </body>
</html>
