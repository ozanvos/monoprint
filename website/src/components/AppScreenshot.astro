---
import { Image } from 'astro:assets';
import studio from '../../assets/studio.png';
---
<figure class="app-screenshot">
  <Image
    src={studio}
    alt="Monoprint for macOS showing Rust source, a code image preview, and theme, typeface, frame and export settings."
    widths={[640, 1280, 1920, 2880]}
    sizes="(max-width: 600px) calc(100vw - 60px), (max-width: 850px) calc(100vw - 84px), (max-width: 1352px) calc(100vw - 140px), 1190px"
    loading="eager"
    fetchpriority="high"
  />
</figure>
