{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "monoprint-site",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "monoprint.7ea.st", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
