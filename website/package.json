{
  "name": "monoprint-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-assets.mjs",
    "dev": "astro dev --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "check": "astro check",
    "preview": "astro preview --host 127.0.0.1",
    "preview:cloudflare": "wrangler dev --ip 127.0.0.1",
    "check:cloudflare": "wrangler deploy --dry-run",
    "deploy": "node scripts/deploy.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "astro": "7.3.5",
    "typescript": "6.0.3",
    "wrangler": "4.145.0"
  }
}
