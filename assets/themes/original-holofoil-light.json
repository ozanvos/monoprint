{
  "name": "original-holofoil-light",
  "type": "light",
  "colors": {
    "editor.foreground": "#24232e",
    "editor.background": "#00000000"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#c2337e",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#2f5fb8",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#9a6a00",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#b3561a",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "string",
        "markup.inline",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#11806a",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "comment",
        "string.quoted.docstring.multi"
      ],
      "settings": {
        "foreground": "#8b8a99",
        "fontStyle": "italic"
      }
    }
  ]
}
