{
  "name": "original-ragged-block-light",
  "type": "light",
  "colors": {
    "editor.foreground": "#14262c",
    "editor.background": "#00000000"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#2f5a1e",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#14262c",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#1e5e63",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#8a4a26",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "string",
        "markup.inline",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#8b5a12",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "comment",
        "string.quoted.docstring.multi"
      ],
      "settings": {
        "foreground": "#4d6b66",
        "fontStyle": ""
      }
    }
  ]
}
