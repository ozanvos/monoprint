{
  "name": "original-wayfinding-light",
  "type": "light",
  "colors": {
    "editor.foreground": "#1d2126",
    "editor.background": "#f6f7f5"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#a87400"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#13836a",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#2a5db0"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#c0502a"
      }
    },
    {
      "scope": [
        "comment",
        "string.quoted.docstring.multi"
      ],
      "settings": {
        "foreground": "#6f7782"
      }
    }
  ]
}
