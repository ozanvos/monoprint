{
  "name": "original-cyanotype-dark",
  "type": "dark",
  "colors": {
    "editor.foreground": "#e6eef8",
    "editor.background": "#00000000"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#e6eef8",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#a8d1ff",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#ffb4a2",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "string",
        "markup.inline",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#ffe29a",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "comment",
        "string.quoted.docstring.multi"
      ],
      "settings": {
        "foreground": "#87a9d1",
        "fontStyle": "italic"
      }
    }
  ]
}
