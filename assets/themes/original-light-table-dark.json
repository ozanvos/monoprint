{
  "name": "original-light-table-dark",
  "type": "dark",
  "colors": {
    "editor.foreground": "#e7dfe0",
    "editor.background": "#00000000"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#d6a3cc",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#93cbb8",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#b6b5dc",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#e2a3b9",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "string",
        "markup.inline",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#e9b07c",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "comment",
        "string.quoted.docstring.multi"
      ],
      "settings": {
        "foreground": "#8e8775",
        "fontStyle": ""
      }
    }
  ]
}
